# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase *anon* (publishable) key. Safe to ship in the app bundle.
# DO NOT put the service_role key here — it bypasses Row Level Security
# and would hand full database access to anyone who unpacks the APK.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# EAS project id (run `eas init` once). Used for push token registration.
EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# These are set as Supabase *Edge Function* secrets, not in the app:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#   supabase secrets set EXPO_ACCESS_TOKEN=...        (optional)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically
# into deployed functions by the Supabase platform.
# ---------------------------------------------------------------------------
